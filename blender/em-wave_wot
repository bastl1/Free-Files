# arrow E
def create_arrow_E(name, extrusion, color):
    verts = [
        # Arrowhead
        ( 1, 0, -0.0), # 0: Tip
        ( 0.6, 0, -0.1), # 1: Head Left
        ( 0.6, 0, 0.1), # 2: Head Right

        # Arrow Stem
        ( 0, 0, 0.05), # 3: top left
        ( 0.6, 0, 0.05), # 4: top right
        ( 0.6, 0, -0.05), # 5: bottom right
        ( 0, 0, -0.05)  # 6: bottom left
    ]

    # Edges (Not strictly necessary for a single face, but good for visualization)
    edges = []

    # Faces (Define the single, non-overlapping face of the arrow)
    faces = [ (0, 1, 2), (3, 4, 5, 6) ]

    mesh = bpy.data.meshes.new(name + "_mesh")
    mesh.from_pydata(verts, edges, faces)
    mesh.update()
    # Create the object
    obj_arrow_E = bpy.data.objects.new(name, mesh)

    # Link object to the scene collection
    bpy.context.collection.objects.link(obj_arrow_E)

    # --- Apply Solidify Modifier for Extrusion (Same style as text) ---
    solidify_modifier = obj_arrow_E.modifiers.new(name="Solidify", type='SOLIDIFY')
    solidify_modifier.thickness = extrusion
    solidify_modifier.offset = 0.0 # Center the extrusion
    
    # Create a material
    mat = bpy.data.materials.new(name + "_Mat")
    mat.diffuse_color = color  # RGBA
    mat.use_nodes = True
    bsdf = mat.node_tree.nodes.get("Principled BSDF")
    if bsdf:
        bsdf.inputs['Base Color'].default_value = color
    obj_arrow_E.data.materials.append(mat)

    return obj_arrow_E

