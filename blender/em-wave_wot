# Material Definitionen
def create_emissive_material(name, color_rgb, emission_strength=5.0):
    mat = bpy.data.materials.new(name=name)
    mat.use_nodes = True
    bsdf = mat.node_tree.nodes["Principled BSDF"]
    mat.node_tree.nodes.remove(bsdf)
    emission = mat.node_tree.nodes.new('ShaderNodeEmission')
    emission.inputs['Color'].default_value = (*color_rgb, 1.0)
    emission.inputs['Strength'].default_value = emission_strength
    material_output = mat.node_tree.nodes.new('ShaderNodeOutputMaterial')
    mat.node_tree.links.new(emission.outputs['Emission'], material_output.inputs['Surface'])
    return mat

