# wave
def create_wave_curve(name, wave_color, wave_func, axis_index):
    # create curve data
    curve_data = bpy.data.curves.new(name, type='CURVE')
    curve_data.dimensions = '3D'
    
    # create spline
    spline = curve_data.splines.new('BEZIER')
    spline.bezier_points.add(num_points - 1)
    
    for i in range(num_points):
        x = x_start + i * segment_length
        coords = [x, 0, 0]
        coords[axis_index] = amplitude * wave_func(x)
        bp = spline.bezier_points[i]
        bp.co = coords
        bp.handle_left_type = 'AUTO'
        bp.handle_right_type = 'AUTO'

    # create object
    obj_wave = bpy.data.objects.new(name + "_Object", curve_data)
    bpy.context.collection.objects.link(obj_wave)
    
    # no shadows
    obj_wave.cycles.cast_shadow = False
    obj_wave.visible_shadow = False

    # MAKE CURVE A TUBE 
    curve_data.bevel_depth = 0.07
    curve_data.bevel_resolution = 6
    curve_data.fill_mode = 'FULL'

    # create emission material
    mat = bpy.data.materials.new(name + "_Mat")
    mat.use_nodes = True
    nodes = mat.node_tree.nodes
    links = mat.node_tree.links

    # remove everything
    for n in nodes:
        nodes.remove(n)

    # emission
    emission = nodes.new("ShaderNodeEmission")
    emission.inputs["Color"].default_value = wave_color
    emission.inputs["Strength"].default_value = 2.0

    # output
    output = nodes.new("ShaderNodeOutputMaterial")
    links.new(emission.outputs["Emission"], output.inputs["Surface"])

    obj_wave.data.materials.append(mat)

    return obj_wave

