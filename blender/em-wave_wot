# Create Text
def creat_text( name="Text", text="text", color=(0,0,1,1), extrusion=0.3, location=(0,0,0), plane=2):
    bpy.ops.object.text_add(location=location, rotation=(0, 0, 0))
    obj_text = bpy.context.object
    obj_text.name = name
    obj_text.data.body = text
    obj_text.data.size = 1.5
    obj_text.data.extrude = extrusion/2
    obj_text.select_set(True)
    #obj_text.data.color = color
    
    plane_rotations = {      
        #0: lambda o: o.rotation_euler.__setitem__(2, 0),
        1: lambda o: o.rotation_euler.__setitem__(0, math.pi/2),
        2: lambda o:
            (                                                  
            o.rotation_euler.__setitem__(0, math.pi/2),
            o.rotation_euler.__setitem__(2, math.pi/2)
            )
        }

    if plane in plane_rotations:
        plane_rotations[plane](obj_text)
        
    # add material
    mat = bpy.data.materials.new(name + "_Mat")
    mat.diffuse_color = color  # RGBA
    mat.use_nodes = True
    bsdf = mat.node_tree.nodes["Principled BSDF"]
    if bsdf:
        bsdf.inputs['Base Color'].default_value = color
    obj_text.data.materials.append(mat)
    
    return obj_text

